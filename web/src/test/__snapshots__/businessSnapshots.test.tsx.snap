exports[`business pages are unchanged > / main content matches the pre-personal snapshot 1`] = `"<div class="page page--dashboard"><div class="page-header"><div class="page-header__text"><h1 class="page-header__title">Dashboard</h1><p class="page-header__subtitle">Sep 1 – Sep 30, 2026 · All businesses<span class="muted"> · compared with Aug 1 – Aug 31, 2026</span></p></div><div class="page-header__actions"><a class="btn btn--secondary btn--md" href="/reports/pnl"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg> View P&amp;L</a></div></div><div class="callout callout--warn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 12h-6l-2 3h-4l-2-3H2"></path><path d="M5.5 5h13L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"></path></svg><span><strong>2 transactions need review.</strong> They count toward net income as uncategorized until you classify them.</span><a class="btn btn--primary btn--sm" href="/review">Review now <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg></a></div><section class="kpi-grid" aria-label="Key figures"><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Net revenue</h3><svg class="sparkline tone-rev" width="84" height="28" viewBox="0 0 84 28" role="img" aria-label="Net revenue trend"><polyline points="2.0,25.0 82.0,3.0" fill="none" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"></polyline><circle cx="82" cy="3" r="2.