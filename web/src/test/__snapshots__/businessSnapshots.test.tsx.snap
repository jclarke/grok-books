exports[`business pages are unchanged > /reports/pnl main content matches the pre-personal snapshot 1`] = `"<div class="page page--report"><div class="page-header"><div class="page-header__text"><div class="page-header__eyebrow"><a class="link-quiet" href="/reports"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"></path></svg> Reports</a></div><h1 class="page-header__title">Profit &amp; Loss</h1><p class="page-header__subtitle">Jan 1 – Oct 1, 2026 · All businesses<span class="muted"> · prior period Jan 1 – Oct 1, 2025</span></p></div><div class="page-header__actions"><div class="export-group" role="group" aria-label="Export"><a class="btn btn--secondary btn--sm" href="/export/pnl.csv?year=2026&amp;by=month&amp;business=all&amp;start=2026-01-01&amp;end=2026-10-01" download=""><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg> CSV</a><a class="btn btn--secondary btn--sm" href="/export/pnl.xlsx?year=2026&amp;by=month&amp;business=all&amp;start=2026-01-01&amp;end=2026-10-01" download=""><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="M7 10l5 5 5-5"></path><path d="M12 15V3"></path></svg> XLSX</a><a class="btn btn--secondary btn--sm" href="/export/pnl.pdf?year=2026&amp;by=month&amp;business=all&amp;start=2026-01-01&amp;end=2026-10-01" download=""><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linec