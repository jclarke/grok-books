exports[`business pages are unchanged > /accounts/acct-checking-0001 main content matches the pre-personal snapshot 1`] = `"<div class="page"><div class="page-header"><div class="page-header__text"><div class="page-header__eyebrow"><a class="link-quiet" href="/accounts"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"></path></svg> Accounts</a></div><h1 class="page-header__title">Bank 1111</h1><p class="page-header__subtitle">Example Bank Checking 1111</p></div><div class="page-header__actions"><button type="button" class="btn btn--secondary btn--sm">Update balance</button></div></div><section class="kpi-grid kpi-grid--3" aria-label="Account totals"><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Imported activity</h3></div><p class="kpi__value num">$96.00</p><div class="kpi__footer"><p class="muted small">Imported activity</p></div></article><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Rows shown</h3></div><p class="kpi__value num">1 transaction</p><div class="kpi__footer"><span class="muted">Sep 1 – Sep 30, 2026</span></div></article><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Type</h3></div><p class="kpi__value num">Cash</p><div class="kpi__footer"><span class="muted">Example Bank</span></div></article></section><div class="toolbar" role="search"><div class="toolbar__search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"></path><path d="M21 21l-4.35-4.35"></path></svg><label class="sr-only" for="reg-search">Search this register</label><input id="reg-search" class="input" type="search" placeholder="Search description, category, or id" maxlength="200" value=""></div><div class="field"><label for=":r:" class="field__label sr-only">Status</label><div class="select select--md"><select id=":r:"><option value="active">Active</option><option value="superseded">Superseded</option><option value="all">All statuses</option></select><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="select__chevron"><path d="M6 9l6 6 6-6"></path></svg></div></div><label class="check"><input type="checkbox"> All dates</label></div><div class="table-card"><div class="table-scroll" role="region" aria-label="Account register" tabindex="0"><table class="table"><caption class="sr-only">Account register</caption><thead><tr><th scope="col" class="align-left" style="width: 112px;">Date</th><th scope="col" class="align-left">Description</th><th scope="col" class="align-left hide-mobile" style="width: 160px;">Business</th><th scope="col" class="align-left hide-mobile" style="width: 200px;">Category</th><th scope="col" class="align-right hide-mobile" style="width: 112px;">Payment</th><th scope="col" class="align-right hide-mobile" style="width: 112px;">Deposit</th><th scope="col" class="align-right show-mobile-cell">Amount</th><th scope="col" class="align-right" style="width: 124px;">Balance</th></tr></thead><tbody><tr class="is-clickable"><td class="align-left"><span class="nowrap">Sep 4, 2026</span></td><td class="align-left"><div class="txn-desc"><span class="txn-desc__name" title="ZZZ HOSTING">ZZZ HOSTING</span><span class="txn-desc__meta"></span></div></td><td class="align-left hide-mobile"><div class="inline-classify inline-classify--tag" data-no-row-click="true"><div class="field inline-select inline-select--brand"><label for=":r:" class="field__label sr-only">Business tag for ZZZ HOSTING</label><div class="select select--sm"><select id=":r:"><option value="branda">Brand A</option><option value="consulting">Consulting</option><option value="general">General</option><option value="owner_draw">Owner draw</option><option value="transfer">Transfer</option><option value="needs_review">Needs review</option></select><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="select__chevron"><path d="M6 9l6 6 6-6"></path></svg></div></div></div></td><td class="align-left hide-mobile"><div class="inline-classify inline-classify--category" data-no-row-click="true"><div class="field inline-select"><label for=":r:" id=":r:-label" class="field__label sr-only">Category for ZZZ HOSTING</label><div class="select select--sm combo"><input id=":r:" type="text" role="combobox" class="combo__input" aria-autocomplete="list" aria-haspopup="listbox" aria-expanded="false" aria-controls=":r:-listbox" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" title="Revenue / Revenue - Hosting" value="Revenue - Hosting"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="select__chevron"><path d="M6 9l6 6 6-6"></path></svg></div></div></div></td><td class="align-right num hide-mobile"></td><td class="align-right num hide-mobile"><span class="money money--pos">$100.00</span></td><td class="align-right num show-mobile-cell"><span class="money money--pos">$100.00</span></td><td class="align-right num"><span class="money money--strong">$96.00</span></td></tr></tbody></table></div><nav class="pagination" aria-label="Pagination"><span class="pagination__info"><span class="num">1</span>–<span class="num">1</span> of <span class="num">1</span></span><div class="pagination__controls"><label class="pagination__size"><span class="sr-only">Rows per page</span><select><option value="50">50 / page</option><option value="100">100 / page</option><option value="250">250 / page</option><option value="500">500 / page</option></select></label><button type="button" class="btn btn--secondary btn--sm" disabled=""><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"></path></svg><span class="hide-mobile">Previous</span></button><button type="button" class="btn btn--secondary btn--sm" disabled=""><span class="hide-mobile">Next</span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"></path></svg></button></div></nav><p class="table-hint"><kbd>j</kbd>/<kbd>k</kbd> move · <kbd>Enter</kbd> open</p></div></div>"`;

exports[`business pages are unchanged > /calendar main content matches the pre-personal snapshot 1`] = `"<div class="page"><div class="page-header"><div class="page-header__text"><h1 class="page-header__title">Calendar &amp; bills</h1><p class="page-header__subtitle">Recurring charges and a 60-day Bank cash outlook · All businesses</p></div></div><div class="callout callout--info" role="note"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z"></path><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><span><strong>This is an estimate.</strong> Recurring items are merchants with at least three charges about a month apart. The outlook starts from the imported Bank 1111 balance and projects only recurring Bank deposits and withdrawals. Card charges leave Bank when the card is paid, so they are not subtracted again.</span></div><section class="kpi-grid" aria-label="Outlook"><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Bank 1111 today</h3></div><p class="kpi__value num">$500.00</p></article><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Projected in 60 days</h3></div><p class="kpi__value num">$300.00</p><div class="kpi__footer"><span class="muted">Through Nov 30, 2026 <span class="badge badge--warn">Estimate</span></span></div></article><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">Lowest projected</h3></div><p class="kpi__value num">$400.00</p><div class="kpi__footer"><span class="muted">Minimum daily balance</span></div></article><article class="card card--padded kpi"><div class="kpi__top"><h3 class="kpi__label">After reserve</h3></div><p class="kpi__value num">$250.00</p><div class="kpi__footer"><span class="muted">Above your reserve</span></div></article></section><section class="card card--padded"><header class="card__header"><div class="card__titles"><h2 class="card__title">60-day cash outlook</h2><p class="card__subtitle">Projected Bank balance with your reserve line <span class="badge badge--warn">Estimate</span></p></div></header><div class="chart"><div class="chart__canvas"><svg width="640" height="240" viewBox="0 0 640 240" role="img" aria-label="Projected Bank 1111 balance over the next 60 days, with the reserve as a horizontal line"><g><line class="chart-grid chart-grid--zero" x1="60" x2="626" y1="212" y2="212"></line><text class="chart-axis" x="52" y="212" dy="0.32em" text-anchor="end">$0.0</text></g><g><line class="chart-grid" x1="60" x2="626" y1="146" y2="146"></line><text class="chart-axis" x="52" y="146" dy="0.32em" text-anchor="end">$200.0</text></g><g><line class="chart-grid" x1="60" x2="626" y1="80" y2="80"></line><text class="chart-axis" x="52" y="80" dy="0.32em" text-anchor="end">$400.0</text></g><g><line class="chart-grid" x1="60" x2="626" y1="14" y2="14"></line><text class="chart-axis" x="52" y="14" dy="0.32em" text-anchor="end">$600.0</text></g><path class="chart-area tone-net" d="M60.0,47.0 L343.0,80.0 L626.0,80.0 L626.0,212.0 L60.0,212.0 Z"></path><path class="chart-line tone-net" d="M60.0,47.0 L343.0,80.0 L626.0,80.0" fill="none"></path><g><line class="chart-threshold tone-reserve" x1="60" x2="626" y1="195.5" y2="195.5"></line><text class="chart-threshold-label tone-reserve" x="626" y="189.5" text-anchor="end">Reserve $50</text></g><circle class="chart-marker tone-net" cx="343" cy="80" r="2.5"></circle><text class="chart-axis" x="60" y="232" text-anchor="start">Oct 1</text><text class="chart-axis" x="343" y="232" text-anchor="middle">Oct 2</text><text class="chart-axis" x="626" y="232" text-anchor="end">Oct 3</text><rect class="chart-hit" x="60" y="14" width="566" height="198"></rect></svg></div></div><form class="reserve"><label class="reserve__label" for="reserve-slider">Cash reserve</label><input id="reserve-slider" class="reserve__slider" type="range" min="0" max="1000000" step="10000" aria-valuetext="$50.00" value="5000"><div class="reserve__input"><span aria-hidden="true">$</span><label for="reserve-amount" class="sr-only">Reserve amount in dollars</label><input id="reserve-amount" class="input input--sm" inputmode="decimal" value="50.00"></div><button type="submit" class="btn btn--primary btn--sm" disabled="">Save reserve</button></form></section><div class="split-2"><section class="card card--padded"><header class="card__header"><div class="card__titles"><h2 class="card__title">Bills due in the next 60 days</h2><p class="card__subtitle">All accounts, by expected date</p></div></header><ol class="timeline" tabindex="0" aria-label="Bills due in the next 60 days"><li class="timeline__item"><span class="timeline__date">Oct 2</span><span class="timeline__dot" aria-hidden="true"></span><span class="timeline__what"><span class="truncate" title="ZZZ RENT">ZZZ RENT</span><span class="muted small">Bank 1111</span></span><span class="money money--neg">-$100.00</span></li></ol></section><section class="card card--padded"><header class="card__header"><div class="card__titles"><h2 class="card__title">Projected Bank activity</h2><p class="card__subtitle">What moves the outlook line</p></div></header><ol class="timeline" tabindex="0" aria-label="Projected Bank activity"><li class="timeline__item"><span class="timeline__date">Oct 1</span><span class="timeline__dot" aria-hidden="true"></span><span class="timeline__what"><span class="truncate" title="Opening balance">Opening balance</span><span class="muted small">Balance <span class="money">$500.00</span></span></span><span></span></li><li class="timeline__item"><span class="timeline__date">Oct 2</span><span class="timeline__dot" aria-hidden="true"></span><span class="timeline__what"><span class="truncate" title="ZZZ RENT">ZZZ RENT</span><span class="muted small">Balance <span class="money">$400.00</span></span></span><span class="money money--neg">-$100.00</span></li></ol></section></div><section><h2 class="section-title">Recurring merchants</h2><div class="table-card"><div class="table-scroll" role="region" aria-label="Recurring merchants" tabindex="0"><table class="table"><caption class="sr-only">Recurring merchants</caption><thead><tr><th scope="col" class="align-left" aria-sort="none"><button type="button" class="th-sort"><span>Merchant</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th><th scope="col" class="align-left hide-mobile" aria-sort="none"><button type="button" class="th-sort"><span>Account</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th><th scope="col" class="align-left hide-mobile" aria-sort="none"><button type="button" class="th-sort"><span>Type</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th><th scope="col" class="align-left hide-mobile" aria-sort="none"><button type="button" class="th-sort"><span>Every</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th><th scope="col" class="align-left hide-mobile" aria-sort="none"><button type="button" class="th-sort"><span>Last</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th><th scope="col" class="align-left" aria-sort="ascending"><button type="button" class="th-sort is-sorted"><span>Next expected</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg></button></th><th scope="col" class="align-right" aria-sort="none"><button type="button" class="th-sort"><span>Last amount</span><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 15l5 5 5-5"></path><path d="M7 9l5-5 5 5"></path></svg></button></th></tr></thead><tbody><tr class="is-clickable"><td class="align-left"><span class="strong truncate" title="ZZZ RENT">ZZZ RENT</span></td><td class="align-left hide-mobile">Bank 1111</td><td class="align-left hide-mobile"><span class="badge badge--neutral">Bill</span></td><td class="align-left hide-mobile">~31 days</td><td class="align-left hide-mobile"><span class="nowrap">Sep 1, 2026</span></td><td class="align-left"><span class="nowrap">Oct 2, 2026</span></td><td class="align-right num"><span class="money money--neg">-$100.00</span></td></tr></tbody></table></div></div></section></div>"`;

exports[`business pages are unchanged > /reports main content matches the pre-personal snapshot 1`] = `"<div class="page"><div class="page-header"><div class="page-header__text"><h1 class="page-header__title">Reports</h1><p class="page-header__subtitle">Jan 1 – Oct 1, 2026 · All businesses. Every report prints cleanly and exports to CSV, XLSX, and PDF.</p></div></div><div class="report-grid"><article class="card card--padded report-card"><a class="report-card__link" href="/reports/pnl"><span class="report-card__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path></svg></span><span class="report-card__text"><span class="report-card__title">Profit &amp; Loss</span><span class="report-card__desc">Income statement by month or for the whole range, compared with the prior period. Click any line to see its transactions.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="report-card__chev"><path d="M9 18l6-6-6-6"></path></svg></a></article><article class="card card--padded report-card"><a class="report-card__link" href="/reports/pnl-by-business"><span class="report-card__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 13h8V3H3z"></path><path d="M13 21h8V11h-8z"></path><path d="M3 21h8v-6H3z"></path><path d="M13 3v6h8V3z"></path></svg></span><span class="report-card__text"><span class="report-card__title">P&amp;L by business</span><span class="report-card__desc">Brand A, Consulting, and General side by side.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="report-card__chev"><path d="M9 18l6-6-6-6"></path></svg></a></article><article class="card card--padded report-card"><a class="report-card__link" href="/reports/cash-flow"><span class="report-card__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 6h20v12H2z"></path><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path><path d="M6 12h.01"></path><path d="M18 12h.01"></path></svg></span><span class="report-card__text"><span class="report-card__title">Cash flow</span><span class="report-card__desc">Money in and out by month and account, without transfers between accounts.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="report-card__chev"><path d="M9 18l6-6-6-6"></path></svg></a></article><article class="card card--padded report-card"><a class="report-card__link" href="/reports/expenses-by-vendor"><span class="report-card__icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 9l1.5-5h15L21 9"></path><path d="M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z"></path><path d="M5 13v8h14v-8"></path><path d="M10 21v-5h4v5"></path></svg></span><span class="report-card__text"><span class="report-card__title">Expenses by vendor</span><span class="report-card__desc">Top merchants by spend for the dates you pick.</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" 